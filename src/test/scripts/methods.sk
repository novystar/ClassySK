class TestArgs:
	public noArgs():
		set {-noArgs} to true

	public singleArg(arg: boolean):
		set {-singleArg} to {_arg}

	public mixedArgs1(arg1: number, arg2: string, arg3: boolean):
		set {-mixedArgs1::arg1} to {_arg1}
		set {-mixedArgs1::arg2} to {_arg2}
		set {-mixedArgs1::arg3} to {_arg3}

	public mixedArgs2(arg1: string, arg2: string, arg3: integer):
		set {-mixedArgs2::arg1} to {_arg1}
		set {-mixedArgs2::arg2} to {_arg2}
		set {-mixedArgs2::arg3} to {_arg3}

	public mixedNumberTypes(numberArg: number, intArg: integer):
		set {-mixedNumberTypes::numberArg} to {_numberArg}
		set {-mixedNumberTypes::intArg} to {_intArg}


	public static static_noArgs():
		set {-static_testNoArgs} to true

	public static_args(arg: boolean):
		set {-static_args::arg} to {_arg}

	public static static_mixedArgs1(arg1: number, arg2: string, arg3: boolean):
		set {-static_mixedArgs1::arg1} to {_arg1}
		set {-static_mixedArgs1::arg2} to {_arg2}
		set {-static_mixedArgs1::arg3} to {_arg3}

	public static static_mixedArgs2(arg1: string, arg2: string, arg3: integer):
		set {-static_mixedArgs2::arg1} to {_arg1}
		set {-static_mixedArgs2::arg2} to {_arg2}
		set {-static_mixedArgs2::arg3} to {_arg3}

	public static static_mixedNumberTypes(numberArg: number, intArg: integer):
		set {-static_mixedNumberTypes::numberArg} to {_numberArg}
		set {-static_mixedNumberTypes::intArg} to {_intArg}

test "ClassySK - Method Arguments":
	set {_instance} to new instance of TestArgs

	{_instance}::noArgs()
	assert {-noArgs} is true


	{_instance}::singleArg(true)
	assert {-singleArg} is true

	delete {-singleArg}
	parse:
		{_instance}::singleArg(false, true)
	assert last parse logs is set
	
	parse:
		{_instance}::singleArg(1)
	assert last parse logs is set


	{_instance}::mixedArgs1(1, "test", true)
	assert {-mixedArgs1::arg1} is 1
	assert {-mixedArgs1::arg2} is "test"
	assert {-mixedArgs1::arg3} is true

	{_instance}::mixedArgs2("test", "test2", 1)
	assert {-mixedArgs2::arg1} is "test"
	assert {-mixedArgs2::arg2} is "test2"
	assert {-mixedArgs2::arg3} is 1
		

	{_instance}::mixedNumberTypes(1, 2)
	assert {-mixedNumberTypes::numberArg} is 1
	assert {-mixedNumberTypes::intArg} is 2

	{_instance}::mixedNumberTypes(1.5, 3)
	assert {-mixedNumberTypes::numberArg} is 1.5
	assert {-mixedNumberTypes::intArg} is 3

	{_instance}::mixedNumberTypes(1.9, 2.5)
	assert {-mixedNumberTypes::numberArg} is 1.9
	assert {-mixedNumberTypes::intArg} is 2

	TestArgs::static_noArgs()
	
	TestArgs::static_mixedArgs1(1, "test", true)
	assert {-static_mixedArgs1::arg1} is 1
	assert {-static_mixedArgs1::arg2} is "test"
	assert {-static_mixedArgs1::arg3} is true

	TestArgs::static_mixedArgs2("test", "test2", 1)
	assert {-static_mixedArgs2::arg1} is "test"
	assert {-static_mixedArgs2::arg2} is "test2"
	assert {-static_mixedArgs2::arg3} is 1

	TestArgs::static_mixedNumberTypes(1, 2)
	assert {-static_mixedNumberTypes::numberArg} is 1
	assert {-static_mixedNumberTypes::intArg} is 2

	TestArgs::static_mixedNumberTypes(1.5, 3)
	assert {-static_mixedNumberTypes::numberArg} is 1.5
	assert {-static_mixedNumberTypes::intArg} is 3

	TestArgs::static_mixedNumberTypes(1.9, 2.5)
	assert {-static_mixedNumberTypes::numberArg} is 1.9
	assert {-static_mixedNumberTypes::intArg} is 2


class TestArgDefaults:

	public list(strs: strings = ("this", "is", "a", "test")):
		set {-def_list::*} to {_strs::*}


	public x(1: integer = 1):
		set {-x::1} to {_1}


	public x_x(1: integer = 1, 2: integer = 2):
		set {-x_x::1} to {_1}
		set {-x_x::2} to {_2}

	public o_x(1: integer, 2: integer = 2):
		set {-o_x::1} to {_1}
		set {-o_x::2} to {_2}

	public x_o(1: integer = 1, 2: integer):
		set {-x_o::1} to {_1}
		set {-x_o::2} to {_2}


	public x_x_x(1: integer = 1, 2: integer = 2, 3: integer = 3):
		set {-x_x_x::1} to {_1}
		set {-x_x_x::2} to {_2}
		set {-x_x_x::3} to {_3}

	public o_x_x(1: integer, 2: integer = 2, 3: integer = 3):
		set {-o_x_x::1} to {_1}
		set {-o_x_x::2} to {_2}
		set {-o_x_x::3} to {_3}

	public x_o_x(1: integer = 1, 2: integer, 3: integer = 3):
		set {-x_o_x::1} to {_1}
		set {-x_o_x::2} to {_2}
		set {-x_o_x::3} to {_3}

	public x_x_o(1: integer = 1, 2: integer = 2, 3: integer):
		set {-x_x_o::1} to {_1}
		set {-x_x_o::2} to {_2}
		set {-x_x_o::3} to {_3}

	public o_x_o(1: integer, 2: integer = 2, 3: integer):
		set {-o_x_o::1} to {_1}
		set {-o_x_o::2} to {_2}
		set {-o_x_o::3} to {_3}

test "ClassySK - Method Argument Defaults":
	set {_instance} to new instance of TestArgDefaults

	{_instance}::list()
	assert {-def_list::*} is "this", "is", "a", "test"
	{_instance}::list("test")
	assert {-def_list::*} is "test"
	{_instance}::list(("test", "test"))
	assert {-def_list::*} is "test", "test"

	{_instance}::x()
	assert {-x::1} is 1
	{_instance}::x(0)
	assert {-x::1} is 0

	{_instance}::x_x()
	assert {-x_x::1} is 1
	assert {-x_x::2} is 2
	{_instance}::x_x(0)
	assert {-x_x::1} is 0
	assert {-x_x::2} is 2
	{_instance}::x_x(0, 1)
	assert {-x_x::1} is 0
	assert {-x_x::2} is 1

	{_instance}::o_x(1)
	assert {-o_x::1} is 1
	assert {-o_x::2} is 2
	{_instance}::o_x(1, 0)
	assert {-o_x::1} is 1
	assert {-o_x::2} is 0

	parse:
		{_instance}::x_o()
	assert last parse logs is set

	parse:
		{_instance}::x_o(1)
	assert last parse logs is set

	{_instance}::x_o(1, 2)
	assert {-x_o::1} is 1
	assert {-x_o::2} is 2
	delete {-x_o::*}
	{_instance}::x_o(2: 2)
	assert {-x_o::1} is 1
	assert {-x_o::2} is 2

	{_instance}::x_x_x()
	assert {-x_x_x::1} is 1
	assert {-x_x_x::2} is 2
	assert {-x_x_x::3} is 3

	{_instance}::x_x_x(0)
	assert {-x_x_x::1} is 0
	assert {-x_x_x::2} is 2
	assert {-x_x_x::3} is 3
	{_instance}::x_x_x(0, 0)
	assert {-x_x_x::1} is 0
	assert {-x_x_x::2} is 0
	assert {-x_x_x::3} is 3
	{_instance}::x_x_x(0, 0, 0)
	assert {-x_x_x::1} is 0
	assert {-x_x_x::2} is 0
	assert {-x_x_x::3} is 0
	{_instance}::x_x_x(2: 0)
	assert {-x_x_x::1} is 1
	assert {-x_x_x::2} is 0
	assert {-x_x_x::3} is 3
	{_instance}::x_x_x(2: 0, 3: 0)
	assert {-x_x_x::1} is 1
	assert {-x_x_x::2} is 0
	assert {-x_x_x::3} is 0
	{_instance}::x_x_x(2: 0, 3: 0, 1: -1)
	assert {-x_x_x::1} is -1
	assert {-x_x_x::2} is 0
	assert {-x_x_x::3} is 0

	parse:
		{_instance}::o_x_x()
	assert last parse logs is set

	{_instance}::o_x_x(1)
	assert {-o_x_x::1} is 1
	assert {-o_x_x::2} is 2
	assert {-o_x_x::3} is 3
	{_instance}::o_x_x(1, 0)
	assert {-o_x_x::1} is 1
	assert {-o_x_x::2} is 0
	assert {-o_x_x::3} is 3

	parse:
		{_instance}::o_x_x(2: 0)
	assert last parse logs is set

	{_instance}::x_o_x(0, 2)
	assert {-x_o_x::1} is 0
	assert {-x_o_x::2} is 2
	assert {-x_o_x::3} is 3
	{_instance}::x_o_x(4, 5, 6)
	assert {-x_o_x::1} is 4
	assert {-x_o_x::2} is 5
	assert {-x_o_x::3} is 6
	{_instance}::x_o_x(2: 1)
	assert {-x_o_x::1} is 1
	assert {-x_o_x::2} is 1
	assert {-x_o_x::3} is 3

	{_instance}::x_x_o(3: 5)
	assert {-x_x_o::1} is 1
	assert {-x_x_o::2} is 2
	assert {-x_x_o::3} is 5
	{_instance}::x_x_o(4, 5, 6)
	assert {-x_x_o::1} is 4
	assert {-x_x_o::2} is 5
	assert {-x_x_o::3} is 6

	parse:
		{_instance}::x_x_o(2: 2)
	assert last parse logs is set

	parse:
		{_instance}::o_x_o()
	assert last parse logs is set
	
	parse:
		{_instance}::o_x_o(1)
	assert last parse logs is set

	parse:
		{_instance}::o_x_o(1, 2)
	assert last parse logs is set

	{_instance}::o_x_o(1: 1, 3: 3)
	assert {-o_x_o::1} is 1
	assert {-o_x_o::2} is 2
	assert {-o_x_o::3} is 3
	{_instance}::o_x_o(4, 5, 6)
	assert {-o_x_o::1} is 4
	assert {-o_x_o::2} is 5
	assert {-o_x_o::3} is 6


class TypeValidation:
	public strings(arg: strings):
		set {-typeStrings::*} to {_arg::*}

	public ints(arg: integers):
		set {-typeInts::*} to {_arg::*}

	public objs(arg: objects):
		set {-typeObjs::*} to {_arg::*}

	public string(arg: string):
		set {-typeString} to {_arg}

	public int(arg: integer):
		set {-typeInt} to {_arg}

	public obj(arg: object):
		set {-typeObj} to {_arg}

test "ClassySK - Method Arguments Type Validation":
	set {_instance} to new instance of TypeValidation

	{_instance}::strings("a")
	assert {-typeStrings::*} is "a"
	{_instance}::strings(("a", "b", "c"))
	assert {-typeStrings::*} is "a", "b", "c"
	delete {-typeStrings::*}
	{_instance}::strings(("a", 2))
	assert {-typeStrings::*} is not set 

	{_instance}::ints(1)
	assert {-typeInts::*} is 1
	{_instance}::ints((1, 2, 3))
	assert {-typeInts::*} is 1, 2, 3
	delete {-typeInts::*}
	{_instance}::ints((1, "b"))
	assert {-typeInts::*} is not set 

	{_instance}::objs(1)
	assert {-typeObjs::*} is 1
	{_instance}::objs((1, "b", true, 2, 3))
	assert {-typeObjs::*} is 1, "b", true, 2, 3


	{_instance}::string("a")
	assert {-typeString} is "a"
	{_instance}::string(1)
	assert {-typeString} is "a"

	{_instance}::string("b", "c")
	assert {-typeString} is "a"
	{_instance}::string("d", 2)
	assert {-typeString} is "a"

	set {_int} to 1
	{_instance}::string({_int})
	assert {-typeString} is not set


	{_instance}::int(2)
	assert {-typeInt} is 2
	{_instance}::int(3.5)
	assert {-typeInt} is 3
	
	set {_test} to 1.5
	{_instance}::int({_test})
	assert {-typeInt} is 1

	set {_test} to "test"
	{_instance}::int({_test})
	assert {-typeInt} is not set


	{_instance}::obj(1)
	assert {-typeObj} is 1

	{_instance}::obj(2.5)
	assert {-typeObj} is 2.5

	{_instance}::obj("a")
	assert {-typeObj} is "a"

	{_instance}::obj(("a", 2))
	assert {-typeObj} is "a"

	set {_list::*} to "a", "b", 3
	parse:
		{_instance}::obj({_list::*})
	assert last parse logs is set

	set {_var} to 10
	{_instance}::obj({_var})
	assert {-typeObj} is 10

class TestOverload:
	public static 1Arg(int: integer):
		set {-1ArgOL} to {_int}

	public static 1Arg(str: string):
		set {-1ArgOL} to {_str}

	public static 1Arg(bool: boolean):
		set {-1ArgOL} to {_bool}


	public static obj(int: integer):
		set {-objOL} to {_int}

	public static obj(str: string):
		set {-objOL} to {_str}

	public static obj(bool: boolean):
		set {-objOL} to {_bool}

	public static obj(obj: object):
		set {-objOL} to {_obj}


test "ClassySK - Method Overloading":
	TestOverload::1Arg(1)
	assert {-1ArgOL} is 1

	TestOverload::1Arg("string")
	assert {-1ArgOL} is "string"

	TestOverload::1Arg(true)
	assert {-1ArgOL} is true

	TestOverload::obj(int: 1)
	assert {-objOL} is 1

	TestOverload::obj(str: "string")
	assert {-objOL} is "string"

	TestOverload::obj(bool: true)
	assert {-objOL} is true

	set {_instance} to new instance of TestOverload
	TestOverload::obj(obj: {_instance})
	assert {-objOL} is {_instance}
	
	TestOverload::obj(obj: 1)
	assert {-objOL} is 1

class TestReturns:
	public returnInt() :: integer:
		return 1

	public returnStr() :: string:
		return "string"

	public returnBool() :: boolean:
		return true


	public returnReturnInt() :: integers:
		return self::returnInt()

	public returnReturnStr() :: strings:
		return self::returnStr()

	public returnReturnBool() :: booleans:
		return self::returnBool()

	
	public returnInts() :: integers:
		return 1, 2, 3

	public returnStrs() :: strings:
		return "this", "is", "a", "test"

	public returnBools() :: booleans:
		return true, false


	public returnReturnInts() :: integers:
		return self::returnInts()

	public returnReturnStrs() :: strings:
		return self::returnStrs()

	public returnReturnBools() :: booleans:
		return self::returnBools()

	
	public returnSelf() :: class instance:
		return self

test "ClassySK - Method Returns":
	set {_instance} to new instance of TestReturns

	assert {_instance}::returnInt() is 1
	assert {_instance}::returnStr() is "string"
	assert {_instance}::returnBool() is true

	assert {_instance}::returnInts() is 1, 2, 3
	assert {_instance}::returnStrs() is "this", "is", "a", "test"
	assert {_instance}::returnBools() is true, false

	assert {_instance}::returnReturnInt() is 1
	assert {_instance}::returnReturnStr() is "string"
	assert {_instance}::returnReturnBool() is true

	assert {_instance}::returnReturnInts() is 1, 2, 3
	assert {_instance}::returnReturnStrs() is "this", "is", "a", "test"
	assert {_instance}::returnReturnBools() is true, false

	assert {_instance}::returnSelf() is {_instance}


parse:
	results: {-testInvalidMethods::*}
	code:
		class TestInvalidMethods:
			public test1()):
				broadcast true

			public test2()():
				broadcast true

			public test3(int: integer = "string"):
				broadcast true

			public test4(int: integer str: string):
				broadcast true

			public test5(int, str, obj):
				broadcast true

			public test6() :: notarealandvalidtype:
				broadcast true

			public test7(test2: integer, test: notarealandvalidtype):
				broadcast true

			public test8(test: notarealandvalidtype):
				broadcast true

			public test9(test: integer, test: string):
				broadcast true

			public test10(()):
				broadcast true

test "ClassySK - Invalid Methods":
	assert size of {-testInvalidMethods::*} is 10