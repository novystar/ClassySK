class testMethods:
	private privateField: string = "im private"
	private static privateStaticField: string = "im private and static"

	public publicMethodFired: boolean = false

	public publicMethod():
		set instance::publicMethodFired to true

	public publicMethodReturn() :: boolean:
		return true

	public publicMethodArgs(arg1: string, arg2: boolean) :: string:
		return "arg1: %{_arg1}%, arg2: %{_arg2}%"

	public privateAccessTest() :: boolean:
		if instance::privateField is "im private":
			if testMethods::privateStaticField is "im private and static":
				return true

test "ClassySK - Methods":
	set {_instance} to new instance of testMethods

	{_instance}::publicMethod()

	assert {_instance}::publicMethodFired is true with "method void"
	assert {_instance}::publicMethodReturn() is true with "method return"

	assert {_instance}::publicMethodArgs("test", true) is "arg1: test, arg2: true" with "method valid args"

	assert {_instance}::publicMethodArgs("test") is not set
	assert {_instance}::publicMethodArgs("test", true, false) is not set
	assert {_instance}::privateAccessTest() is true with "private access from method"