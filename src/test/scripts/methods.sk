class TestArgs:
	public noArgs():
		set {-noArgs} to true

	public singleArg(arg: boolean):
		set {-singleArg} to {_arg}

	public mixedArgs1(arg1: number, arg2: string, arg3: boolean):
		set {-mixedArgs1::arg1} to {_arg1}
		set {-mixedArgs1::arg2} to {_arg2}
		set {-mixedArgs1::arg3} to {_arg3}

	public mixedArgs2(arg1: string, arg2: string, arg3: integer):
		set {-mixedArgs2::arg1} to {_arg1}
		set {-mixedArgs2::arg2} to {_arg2}
		set {-mixedArgs2::arg3} to {_arg3}

	public mixedNumberTypes(numberArg: number, intArg: integer):
		set {-mixedNumberTypes::numberArg} to {_numberArg}
		set {-mixedNumberTypes::intArg} to {_intArg}


	public static static_noArgs():
		set {-static_testNoArgs} to true

	public static_args(arg: boolean):
		set {-static_args::arg} to {_arg}

	public static static_mixedArgs1(arg1: number, arg2: string, arg3: boolean):
		set {-static_mixedArgs1::arg1} to {_arg1}
		set {-static_mixedArgs1::arg2} to {_arg2}
		set {-static_mixedArgs1::arg3} to {_arg3}

	public static static_mixedArgs2(arg1: string, arg2: string, arg3: integer):
		set {-static_mixedArgs2::arg1} to {_arg1}
		set {-static_mixedArgs2::arg2} to {_arg2}
		set {-static_mixedArgs2::arg3} to {_arg3}

	public static static_mixedNumberTypes(numberArg: number, intArg: integer):
		set {-static_mixedNumberTypes::numberArg} to {_numberArg}
		set {-static_mixedNumberTypes::intArg} to {_intArg}

test "ClassySK - Method Arguments":
	set TestArgs::static_ to new instance of TestArgs

	TestArgs::static_noArgs()
	assert {-noArgs} is true


	TestArgs::static_singleArg(true)
	assert {-singleArg} is true

	delete {-singleArg}
	TestArgs::static_singleArg(false, true)
	assert {-singleArg} is not set
	
	TestArgs::static_singleArg(1)
	assert {-singleArg} is not set


	TestArgs::static_mixedArgs1(1, "test", true)
	assert {-mixedArgs1::arg1} is 1
	assert {-mixedArgs1::arg2} is "test"
	assert {-mixedArgs1::arg3} is true

	TestArgs::static_mixedArgs2("test", "test2", 1)
	assert {-mixedArgs2::arg1} is "test"
	assert {-mixedArgs2::arg2} is "test2"
	assert {-mixedArgs2::arg3} is 1
		

	TestArgs::static_mixedNumberTypes(1, 2)
	assert {-mixedNumberTypes::numberArg} is 1
	assert {-mixedNumberTypes::intArg} is 2

	TestArgs::static_mixedNumberTypes(1.5, 3)
	assert {-mixedNumberTypes::numberArg} is 1.5
	assert {-mixedNumberTypes::intArg} is 3

	TestArgs::static_mixedNumberTypes(1.5, 2.5)
	assert {-mixedNumberTypes::numberArg} is 1.5
	assert {-mixedNumberTypes::intArg} is 2

	TestArgs::static_noArgs()
	
	TestArgs::static_mixedArgs1(1, "test", true)
	assert {-static_mixedArgs1::arg1} is 1
	assert {-static_mixedArgs1::arg2} is "test"
	assert {-static_mixedArgs1::arg3} is true

	TestArgs::static_mixedArgs2("test", "test2", 1)
	assert {-static_mixedArgs2::arg1} is "test"
	assert {-static_mixedArgs2::arg2} is "test2"
	assert {-static_mixedArgs2::arg3} is 1

	TestArgs::static_mixedNumberTypes(1, 2)
	assert {-static_mixedNumberTypes::numberArg} is 1
	assert {-static_mixedNumberTypes::intArg} is 2

	TestArgs::static_mixedNumberTypes(1.5, 3)
	assert {-static_mixedNumberTypes::numberArg} is 1.5
	assert {-static_mixedNumberTypes::intArg} is 3

	TestArgs::static_mixedNumberTypes(1.5, 2.5)
	assert {-static_mixedNumberTypes::numberArg} is 1.5
	assert {-static_mixedNumberTypes::intArg} is 2


class TestArgDefaults:

	public x(1: integer = 1):
		set {-x::1} to {_1}


	public x_x(1: integer = 1, 2: integer = 2):
		set {-x_x::1} to {_1}
		set {-x_x::2} to {_2}

	public o_x(1: integer, 2: integer = 2):
		set {-o_x::1} to {_1}
		set {-o_x::2} to {_2}

	public x_o(1: integer = 1, 2: integer):
		set {-x_o::1} to {_1}
		set {-x_o::2} to {_2}


	public x_x_x(1: integer = 1, 2: integer = 2, 3: integer = 3):
		set {-x_x_x::1} to {_1}
		set {-x_x_x::2} to {_2}
		set {-x_x_x::3} to {_3}

	public o_x_x(1: integer, 2: integer = 2, 3: integer = 3):
		set {-o_x_x::1} to {_1}
		set {-o_x_x::2} to {_2}
		set {-o_x_x::3} to {_3}

	public x_o_x(1: integer = 1, 2: integer, 3: integer = 3):
		set {-x_o_x::1} to {_1}
		set {-x_o_x::2} to {_2}
		set {-x_o_x::3} to {_3}

	public x_x_o(1: integer = 1, 2: integer = 2, 3: integer):
		set {-x_x_o::1} to {_1}
		set {-x_x_o::2} to {_2}
		set {-x_x_o::3} to {_3}

	public o_x_o(1: integer, 2: integer = 2, 3: integer):
		set {-o_x_o::1} to {_1}
		set {-o_x_o::2} to {_2}
		set {-o_x_o::3} to {_3}

test "ClassySK - Method Argument Defaults":
	set TestArgs::static_ to new instance of TestArgDefaults

	TestArgs::static_::x()
	assert {-x::1} is 1
	TestArgs::static_::x(0)
	assert {-x::1} is 0

	TestArgs::static_::x_x()
	assert {-x_x::1} is 1
	assert {-x_x::2} is 2
	TestArgs::static_::x_x(0)
	assert {-x_x::1} is 0
	assert {-x_x::2} is 2
	TestArgs::static_::x_x(0, 1)
	assert {-x_x::1} is 0
	assert {-x_x::2} is 1

	TestArgs::static_::o_x(1)
	assert {-o_x::1} is 1
	assert {-o_x::2} is 2
	TestArgs::static_::o_x(1, 0)
	assert {-o_x::1} is 1
	assert {-o_x::2} is 0

	TestArgs::static_::x_o()
	assert {-x_o::*} is not set
	TestArgs::static_::x_o(1)
	assert {-x_o::*} is not set
	TestArgs::static_::x_o(1, 2)
	assert {-x_o::1} is 1
	assert {-x_o::2} is 2
	delete {-x_o::*}
	TestArgs::static_::x_o(2: 2)
	assert {-x_o::1} is 1
	assert {-x_o::2} is 2

	TestArgs::static_::x_x_x()
	assert {-x_x_x::1} is 1
	assert {-x_x_x::2} is 2
	assert {-x_x_x::3} is 3

	TestArgs::static_::x_x_x(0)
	assert {-x_x_x::1} is 0
	assert {-x_x_x::2} is 2
	assert {-x_x_x::3} is 3
	TestArgs::static_::x_x_x(0, 0)
	assert {-x_x_x::1} is 0
	assert {-x_x_x::2} is 0
	assert {-x_x_x::3} is 3
	TestArgs::static_::x_x_x(0, 0, 0)
	assert {-x_x_x::1} is 0
	assert {-x_x_x::2} is 0
	assert {-x_x_x::3} is 0
	TestArgs::static_::x_x_x(2: 0)
	assert {-x_x_x::1} is 1
	assert {-x_x_x::2} is 0
	assert {-x_x_x::3} is 3
	TestArgs::static_::x_x_x(2: 0, 3: 0)
	assert {-x_x_x::1} is 1
	assert {-x_x_x::2} is 0
	assert {-x_x_x::3} is 0
	TestArgs::static_::x_x_x(2: 0, 3: 0, 1: -1)
	assert {-x_x_x::1} is -1
	assert {-x_x_x::2} is 0
	assert {-x_x_x::3} is 0

	TestArgs::static_::o_x_x()
	assert {-o_x_x::*} is not set
	TestArgs::static_::o_x_x(1)
	assert {-o_x_x::1} is 1
	assert {-o_x_x::2} is 2
	assert {-o_x_x::3} is 3
	TestArgs::static_::o_x_x(1, 0)
	assert {-o_x_x::1} is 1
	assert {-o_x_x::2} is 0
	assert {-o_x_x::3} is 3
	delete {-o_x_x::*}
	TestArgs::static_::o_x_x(2: 0)
	assert {-o_x_x::*} is not set

	TestArgs::static_::x_o_x(0, 2)
	assert {-x_o_x::1} is 0
	assert {-x_o_x::2} is 2
	assert {-x_o_x::3} is 3
	TestArgs::static_::x_o_x(4, 5, 6)
	assert {-x_o_x::1} is 4
	assert {-x_o_x::2} is 5
	assert {-x_o_x::3} is 6
	TestArgs::static_::x_o_x(2: 1)
	assert {-x_o_x::1} is 1
	assert {-x_o_x::2} is 1
	assert {-x_o_x::3} is 3

	TestArgs::static_::x_x_o(3: 5)
	assert {-x_x_o::1} is 1
	assert {-x_x_o::2} is 2
	assert {-x_x_o::3} is 5
	TestArgs::static_::x_x_o(4, 5, 6)
	assert {-x_x_o::1} is 4
	assert {-x_x_o::2} is 5
	assert {-x_x_o::3} is 6
	delete {-x_x_o::*}
	TestArgs::static_::x_x_o(2: 2)
	assert {-x_x_o::*} is not set

	TestArgs::static_::o_x_o()
	assert {-o_x_o::*} is not set
	TestArgs::static_::o_x_o(1)
	assert {-o_x_o::*} is not set
	TestArgs::static_::o_x_o(1, 2)
	assert {-o_x_o::*} is not set
	TestArgs::static_::o_x_o(1: 1, 3: 3)
	assert {-o_x_o::1} is 1
	assert {-o_x_o::2} is 2
	assert {-o_x_o::3} is 3
	TestArgs::static_::o_x_o(4, 5, 6)
	assert {-o_x_o::1} is 4
	assert {-o_x_o::2} is 5
	assert {-o_x_o::3} is 6

# TODO
class TypeValidation:
	public strings(arg: strings):
		set {-typeStrings::*} to {_arg::*}

	public ints(arg: integers):
		set {-typeInts::*} to {_arg::*}

	public nums(arg: numbers):
		set {-typeNums} to {_arg::*}

	public objs(arg: objects):
		set {-typeObjs::*} to {_arg::*}

	public string(arg: string):
		set {-typeString} to {_arg}

	public int(arg: integer):
		set {-typeInt} to {_arg}

	public num(arg: number):
		set {-typeNum} to {_arg}